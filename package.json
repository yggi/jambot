{
  "name": "jambot",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "pnpm --filter @jambot/web dev",
    "build": "pnpm --filter @jambot/web build",
    "preview": "pnpm --filter @jambot/web preview",
    "lobby": "pnpm --filter @jambot/lobby start",
    "lobby:deploy": "fly deploy . --config apps/lobby/fly.toml --dockerfile apps/lobby/Dockerfile --ha=false",
    "pages": "node --experimental-strip-types --no-warnings tooling/pages.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm -r run check",
    "lint": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ .",
    "format": "prettier --write .",
    "format:check": "prettier --check --cache --cache-strategy content .",
    "verify": "node --experimental-strip-types --no-warnings tooling/verify.ts",
    "e2e": "node --experimental-strip-types --no-warnings tooling/heavy.ts pnpm --filter @jambot/web e2e",
    "soak": "node --experimental-strip-types --no-warnings tooling/heavy.ts node --experimental-strip-types --no-warnings apps/web/e2e/soak.ts",
    "heavy": "node --experimental-strip-types --no-warnings tooling/heavy.ts",
    "ratchet": "node --experimental-strip-types --no-warnings tooling/history.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "tonal": "^6.4.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}

#!/bin/sh
# Runs `pnpm verify` before any `git push` of a branch, and blocks the push if
# it fails. CI is only a witness (docs/memory/repository-and-ci.md), so this is the check that counts. It is
# git's own pre-push hook, so it holds for a human, an agent and a `sh -c`
# alike; `pnpm install` and session-start.sh point `core.hooksPath` here.
# Bypassing it with `--no-verify` is not for agents.
#
# - It verifies the working tree, and the push sends the commit, so a dirty
#   tracked tree is refused: commit first, and push the branch checked out.
# - A tree that passed is remembered by its hash (in the git directory), so a
#   push retried after a network failure does not run the tests again. `pnpm
#   verify` run by hand remembers the tree it passed in the same file
#   (tooling/verify.ts), so a push right after it does not run it again either.
#   That tree holds every file verify saw, untracked ones too: a commit that
#   leaves out a new file verify passed with has another tree, and is verified
#   again. For the same reason this hook remembers HEAD's tree only when no
#   untracked file was there to be seen.
# - A push it lets through says so in one line, with the count of tests that
#   passed, for the pull request to quote.
# - A check that failed leaves its whole output in the git directory
#   (`jambot-verify-failed.log`), named in the message: the last 40 lines
#   shown may not reach the failure.
# - A branch that differs from `origin/main` in `*.md` files alone runs the
#   format check and the tooling tests (the pawl over the catalogues among
#   them) instead of everything: `pnpm verify --docs`, which installs a
#   checkout without `node_modules` first and ends with the same summary.
# - Deleting a ref, pushing a tag and the deploy's push to `gh-pages` (which
#   runs `pnpm verify` itself) are not checked.
# JAMBOT_VERIFY and JAMBOT_VERIFY_DOCS replace the two checks, for
# tooling/hooks.test.ts.
cd "$(git rev-parse --show-toplevel)" || exit 1

# git hands the hook one line per ref: local ref, local sha, remote ref, remote sha.
head=$(git rev-parse HEAD)
checked=
while read -r local_ref local_sha remote_ref _; do
  case "$remote_ref" in
    refs/heads/gh-pages) continue ;;
    refs/heads/*) ;;
    *) continue ;;
  esac
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  if [ "$local_sha" != "$head" ]; then
    echo "pre-push: $local_ref is not the checked out commit, and verify checks the tree. Check it out, then push." >&2
    exit 1
  fi
  checked=1
done
[ -n "$checked" ] || exit 0

if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  echo 'pre-push: tracked files have uncommitted changes, and verify checks the tree, not the commit. Commit them, then push again.' >&2
  exit 1
fi

stamps="$(git rev-parse --absolute-git-dir)/jambot-verified"
tree=$(git rev-parse 'HEAD^{tree}')
short=$(git rev-parse --short "$tree")
if grep -qx "$tree" "$stamps" 2>/dev/null; then
  echo "pre-push: tree $short passed pnpm verify before, so it is not run again." >&2
  exit 0
fi

changed=$(git diff --name-only origin/main...HEAD 2>/dev/null) || changed=
if [ -n "$changed" ] && ! printf '%s\n' "$changed" | grep -qv '\.md$'; then
  check="${JAMBOT_VERIFY_DOCS:-pnpm verify --docs}"
  name='the docs check (markdown alone changed)'
  stamp=
else
  check="${JAMBOT_VERIFY:-pnpm verify}"
  name='pnpm verify'
  stamp=1
fi

# In a linked worktree git hands the hook GIT_DIR and friends, and a check that
# makes a repository of its own (the tests do) would talk to this one instead:
# it once overwrote `main` on the remote.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR GIT_OBJECT_DIRECTORY
log=$(mktemp)
if ! sh -c "$check" >"$log" 2>&1; then
  # The whole output is kept, since its last lines may miss the failure.
  kept="$(git rev-parse --absolute-git-dir)/jambot-verify-failed.log"
  mv "$log" "$kept"
  tail -40 "$kept" >&2
  echo 'pre-push: the check failed, so the push was blocked. Fix it, commit, and push again.' >&2
  echo "pre-push: full log: $kept" >&2
  exit 1
fi
# vitest's summary line, `Tests  12 passed (12)`, the one review-pr reads too.
tests=$(sed -n 's/^ *Tests  *\([0-9][0-9]* failed | \)\{0,1\}\([0-9][0-9]*\) passed.*/\2/p' "$log" | tail -1)
rm -f "$log"
# verify remembers a tree it passed itself; a check put in its place does not.
# An untracked file the check saw makes the tree it passed another than HEAD's.
if [ -n "$stamp" ] && [ -z "$(git status --porcelain)" ] && ! grep -qx "$tree" "$stamps" 2>/dev/null; then
  echo "$tree" >>"$stamps"
fi
echo "pre-push: $name passed on tree $short${tests:+, $tests tests passed}, so the push goes ahead." >&2
exit 0

{
  "permissions": {
    "allow": [
      "Bash(pnpm install:*)",
      "Bash(pnpm verify)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm check)",
      "Bash(pnpm format:check)",
      "Bash(pnpm build)",
      "Bash(pnpm e2e)",
      "Bash(uv run .claude/skills/music-theory/oracle.py:*)",
      "Bash(node .claude/skills/music-theory/tonal.mjs:*)",
      "Bash(node .claude/skills/music-theory/compare.mjs:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
